# Every setting is explained in docs/configuration.md.

# Plex: easiest is ⚙ → Server → Plex → Sign in with Plex in the web UI (a sign-in there wins over these).
# Or set the server address and a token here for a headless setup.
PLEX_URL=
PLEX_TOKEN=

# Hostnames you open WhatsOn by, comma-separated (IP addresses and localhost always work).
# Needed when it sits behind a reverse proxy or you use a DNS name, e.g. whatson.home.lan.
ALLOWED_HOSTS=

# Guide window and refresh intervals.
GUIDE_HOURS=24
GUIDE_REFRESH_MINUTES=15
LIBRARY_REFRESH_MINUTES=360
SPORTS_REFRESH_MINUTES=5

# ESPN scoreboard feeds used to put team names and scores on sports listings.
# ESPN_LEAGUES=football/college-football,football/nfl,basketball/nba,hockey/nhl,baseball/mlb

# Optional Radarr (movies) and Sonarr (shows) for "Get it". Easiest: set them in the web UI
# (⚙ → More → Downloads), which also picks default folders, quality and anime routing. Values saved there win;
# these keys are only used with the address set next to them. API key: Settings → General in each app.
RADARR_URL=
RADARR_KEY=
SONARR_URL=
SONARR_KEY=

# Optional AI search. Easiest: set it in the web UI (⚙ → More → AI search); values saved there win.
# Or here. Leave as "none" for keyword search only.
#   anthropic  -> needs ANTHROPIC_API_KEY (default model claude-opus-5-5; set AI_MODEL to change)
#   openai     -> OpenAI or any OpenAI-compatible server (LM Studio, Ollama, vLLM): set AI_MODEL,
#                 plus AI_BASE_URL for a local server (no key needed there) or OPENAI_API_KEY for OpenAI
#   openrouter -> needs OPENROUTER_API_KEY and AI_MODEL (e.g. a model id from openrouter.ai/models)
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
# Seconds to wait for an AI answer before falling back to keyword search.
AI_TIMEOUT=30
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
